# Copia este archivo como .env y rellena los valores reales
# NUNCA commitees el .env con valores reales

# Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# API
VITE_API_BASE_URL=

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=false

# App
VITE_APP_NAME=Barbería App
VITE_APP_VERSION=1.0.0
VITE_NOTIFY_WEBHOOK_URL=
VITE_NOTIFY_EMAIL_TO=

# EmailJS (solo PUBLIC KEY va aquí — la private key NUNCA al frontend)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID_CANCELACION=
VITE_EMAILJS_PUBLIC_KEY=

# Instagram Feed
VITE_INSTAGRAM_TOKEN=
VITE_FACEBOOK_PAGE_ID=
