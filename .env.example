# Environment Variables Example
# Copy this file to .env and fill in your values

# Firebase Configuration
# Replace these with your actual values from Firebase Console (Project info > Web App)
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_AUTH_DOMAIN
VITE_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_STORAGE_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=YOUR_FIREBASE_MEASUREMENT_ID

# API Configuration
VITE_API_BASE_URL=https://your-api-url.com/

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=false

# Application Settings
VITE_APP_NAME=Barbería App
VITE_APP_VERSION=1.0.0
VITE_NOTIFY_WEBHOOK_URL=
VITE_NOTIFY_EMAIL_TO=

# EmailJS Configuration
VITE_EMAILJS_SERVICE_ID=YOUR_SERVICE_ID
VITE_EMAILJS_TEMPLATE_ID_CANCELACION=YOUR_TEMPLATE_ID
VITE_EMAILJS_PUBLIC_KEY=YOUR_PUBLIC_KEY
# VITE_EMAILJS_PRIVATE_KEY NO DEBE IR EN EL FRONTEND

# Instagram Feed
VITE_INSTAGRAM_TOKEN=YOUR_INSTAGRAM_ACCESS_TOKEN
# ID de la Página de Facebook vinculada a Instagram (de Meta Business Suite)
VITE_FACEBOOK_PAGE_ID=YOUR_FACEBOOK_PAGE_ID
