{
  "outputDirectory": "build",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://manito-api.onrender.com/api/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "https://manito-api.onrender.com/assets/:path*"
    },
    {
      "source": "/instagram-api/:path*",
      "destination": "https://graph.facebook.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
